{
  "name": "feishu-ai-bot",
  "version": "0.3.0",
  "description": "Feishu AI bot with Codex and Claude Code support",
  "type": "module",
  "bin": {
    "feishu-ai-bot": "./dist/bin/feishu-ai-bot.js",
    "feishu-runtime": "./dist/bin/feishu-runtime.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run build && bash -n deploy.sh && bash -n scripts/bootstrap-system.sh && bash -n scripts/ensure-dependencies.sh && bash -n bin/feishu-runtime && bash -n bin/feishu-ai-bot && node dist/scripts/audit-dependencies.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify": "npm run check && node --test dist/test/*.test.js",
    "audit:licenses": "npm run build && node dist/scripts/audit-dependencies.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/codex-acp": "1.6.2",
    "@agentclientprotocol/sdk": "1.3.0",
    "@larksuiteoapi/node-sdk": "1.76.0"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
